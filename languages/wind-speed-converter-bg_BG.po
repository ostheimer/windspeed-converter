#: windspeed-converter.php:80
msgid "* Use . (dot) as comma."
msgstr "* Използвайте . (точка) като десетичен разделител."

#: windspeed-converter.php:81
msgid "* Number between 1 and 12"
msgstr "* Число между 1 и 12"

#: windspeed-converter.php:82
msgid "* Number must be an integer."
msgstr "* Числото трябва да бъде цяло число."

